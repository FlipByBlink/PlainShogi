      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- Supported Spatial SharePlay.\n- Fixed a bug that prevented starting SharePlay from the system UI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空間SharePlayに対応。\nシステムUIからSharePlayを開始出来ない不具合を修正。"
          }
        }
      }
    },
    "1.7" : {
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSとのSharePlayに対応。\n選択中の駒をもう一度タップした際に裏返すのではなく、選択解除するように仕様を変更。\n空間SharePlay中の参加者の立ち位置を会話しやすいように変更。\n様々な改善や修正。"
          }
        }
      }
    }
  },
  "version" : "1.0"
